{
  "name": "opencoding",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCoding Agent Desktop — AI Coding Agent with Electron + embedded backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:desktop": "npm -w apps/desktop run dev",
    "build:desktop": "npm -w apps/desktop run build",
    "build:api": "npm -w packages/api run build",
    "build:core": "npm -w packages/core run build",
    "build:server": "npm -w packages/server run build",
    "build:transport-ipc": "npm -w packages/transport-ipc run build",
    "build:transport-stdio": "npm -w packages/transport-stdio run build",
    "build:packages": "npm run build:api && npm run build:core && npm run build:server && npm run build:transport-ipc && npm run build:transport-stdio",
    "build:desktop:full": "npm run build:packages && npm run build:desktop"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
