{
  "name": "@opencode/server",
  "version": "0.1.0",
  "description": "OpenCoding backend service host (Transport layer + JSON-RPC router + lifecycle)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@opencode/api": "*",
    "@opencode/core": "*",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@types/node": "^22.10.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
