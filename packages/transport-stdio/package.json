{
  "name": "@opencode/transport-stdio",
  "version": "0.1.0",
  "description": "OpenCoding — stdio Transport 客户端 (Node.js 子进程)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@opencode/api": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "rimraf": "^5.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}
